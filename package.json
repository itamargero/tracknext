{
  "name": "tracknext",
  "version": "0.1.0",
  "description": "First, middle, and last marketing touch attribution for Next.js.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itamargero/tracknext.git"
  },
  "homepage": "https://github.com/itamargero/tracknext#readme",
  "bugs": {
    "url": "https://github.com/itamargero/tracknext/issues"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=20.9.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "default": "./dist/next.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:postgres": "npm run build && node --experimental-strip-types scripts/test-postgres.mjs",
    "test:package": "npm run build && node scripts/test-package.mjs",
    "dev:example": "npm run build && npm install --prefix examples/next-app && npm run dev --prefix examples/next-app",
    "build:example": "npm run build && npm install --prefix examples/next-app && npm run build --prefix examples/next-app",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "nextjs",
    "attribution",
    "utm",
    "marketing",
    "middleware",
    "proxy",
    "referrer"
  ],
  "peerDependencies": {
    "next": "^16.0.0"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/react": "^19.2.0",
    "next": "^16.4.2",
    "pg": "^8.16.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
